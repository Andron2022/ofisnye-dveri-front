# Runtime environment: development, staging, production.
APP_ENV=development
DEPLOYMENT_ID=local

# Search indexing safety switch. Keep false locally and on staging.
# Set true only on the production storefront after the production domain is ready.
SITE_INDEXING_ENABLED=false

# Public storefront URL. Use the real HTTPS domain on staging/production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Public WordPress origin used by server-side WP REST requests.
WORDPRESS_URL=https://wp.example.com

# WooCommerce read credentials used by catalog/server rendering.
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me

# Optional dedicated WooCommerce write credentials for BFF order creation.
# When configured, both variables are required. Otherwise writes fall back to the read pair.
WC_WRITE_CONSUMER_KEY=ck_write_replace_me
WC_WRITE_CONSUMER_SECRET=cs_write_replace_me

# WordPress Navigation slugs used by the storefront header and footer.
WP_HEADER_NAVIGATION_SLUG=header-menu
WP_FOOTER_NAVIGATION_SLUG=footer-menu

# WP page slug containing global header/footer ACF settings.
WP_SITE_CHROME_PAGE_SLUG=nastrojki-sajta

# Optional server-side REST diagnostics.
WP_REST_DEBUG=false
WP_REST_TIMEOUT_MS=10000
WP_REST_RETRY_COUNT=1

# BFF write protection. Generate with: openssl rand -hex 32
BFF_SECURITY_SECRET=replace_with_a_long_random_secret

# Comma-separated origins allowed to POST to BFF endpoints.
BFF_ALLOWED_ORIGINS=http://localhost:3000

# Keep false locally. Must be true on staging and production.
BFF_REQUIRE_ORIGIN=false

# Per-process safety net. Nginx remains the outer rate-limit layer on VDS.
BFF_RATE_LIMIT_WINDOW_MS=900000
BFF_CHECKOUT_RATE_LIMIT=5
BFF_WALL_PANEL_RATE_LIMIT=8

# Optional runtime binding. systemd templates set these explicitly.
PORT=3000
HOSTNAME=127.0.0.1

# Local development only. Never set this to 0 on staging or production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
