APP_ENV=staging
DEPLOYMENT_ID=staging-manual
SITE_INDEXING_ENABLED=false

NEXT_PUBLIC_SITE_URL=https://staging-shop.example.com
SITE_URL=https://staging-shop.example.com
WORDPRESS_URL=https://staging-wp.example.com

WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
WC_WRITE_CONSUMER_KEY=ck_write_replace_me
WC_WRITE_CONSUMER_SECRET=cs_write_replace_me

WP_HEADER_NAVIGATION_SLUG=header-menu
WP_FOOTER_NAVIGATION_SLUG=footer-menu
WP_SITE_CHROME_PAGE_SLUG=nastrojki-sajta

WP_REST_DEBUG=false
WP_REST_TIMEOUT_MS=15000
WP_REST_RETRY_COUNT=1

BFF_SECURITY_SECRET=replace_with_at_least_32_random_characters
BFF_ALLOWED_ORIGINS=https://staging-shop.example.com
BFF_REQUIRE_ORIGIN=true
BFF_RATE_LIMIT_WINDOW_MS=900000
BFF_CHECKOUT_RATE_LIMIT=5
BFF_WALL_PANEL_RATE_LIMIT=8

HOSTNAME=127.0.0.1
PORT=3000
NODE_ENV=production
