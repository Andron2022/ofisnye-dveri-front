# Runtime + build environment for production.
# PRELAUNCH DEFAULT: keep SITE_INDEXING_ENABLED=false until the separate launch step.
APP_ENV=production
SITE_INDEXING_ENABLED=false
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

NEXT_PUBLIC_SITE_URL=https://ofisnye-dveri.ru
SITE_URL=https://ofisnye-dveri.ru
WORDPRESS_URL=https://wp.ofisnye-dveri.ru

# Dedicated read-only Woo REST credentials for catalog/server rendering.
WC_CONSUMER_KEY=ck_production_read_replace_me
WC_CONSUMER_SECRET=cs_production_read_replace_me

# Dedicated read/write Woo REST credentials used only by BFF order creation.
# These must differ from the read-only pair above.
WC_WRITE_CONSUMER_KEY=ck_production_write_replace_me
WC_WRITE_CONSUMER_SECRET=cs_production_write_replace_me

WP_HEADER_NAVIGATION_SLUG=header-menu
WP_FOOTER_NAVIGATION_SLUG=footer-menu
WP_SITE_CHROME_PAGE_SLUG=nastrojki-sajta
WP_REST_DEBUG=false
WP_REST_TIMEOUT_MS=10000
WP_REST_RETRY_COUNT=1

# Generate a new production-only value with: openssl rand -hex 32
BFF_SECURITY_SECRET=replace_with_at_least_32_random_characters
BFF_ALLOWED_ORIGINS=https://ofisnye-dveri.ru
BFF_REQUIRE_ORIGIN=true
BFF_RATE_LIMIT_WINDOW_MS=900000
BFF_CHECKOUT_RATE_LIMIT=5
BFF_WALL_PANEL_RATE_LIMIT=8

# Never add NODE_TLS_REJECT_UNAUTHORIZED=0 here.
