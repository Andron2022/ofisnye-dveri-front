upstream storefront_staging {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name staging-shop.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging-shop.example.com;

    ssl_certificate /etc/letsencrypt/live/staging-shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging-shop.example.com/privkey.pem;

    client_max_body_size 1m;

    location = /api/checkout/order {
        limit_req zone=storefront_checkout burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://storefront_staging;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location = /api/wall-panels/request {
        limit_req zone=storefront_wall_panels burst=8 nodelay;
        limit_req_status 429;
        proxy_pass http://storefront_staging;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location /_next/static/ {
        proxy_pass http://storefront_staging;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://storefront_staging;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }
}
