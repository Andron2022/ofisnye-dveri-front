# Public production storefront. Do NOT enable this during the prelaunch step.
# It replaces ofisnye-dveri-production-prelaunch only during the later cutover.
upstream ofisnye_dveri_production {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ofisnyedveri.ru www.ofisnyedveri.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://ofisnyedveri.ru$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.ofisnyedveri.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ofisnyedveri.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ofisnyedveri.ru/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    return 301 https://ofisnyedveri.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ofisnyedveri.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ofisnyedveri.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ofisnyedveri.ru/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 128k;
    limit_conn storefront_per_ip 20;

    access_log /var/log/nginx/ofisnye-dveri-production.access.log;
    error_log /var/log/nginx/ofisnye-dveri-production.error.log warn;

    location = /api/checkout/order {
        client_max_body_size 64k;
        limit_req zone=storefront_checkout burst=4 nodelay;
        limit_req_status 429;
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }

    location = /api/wall-panels/request {
        client_max_body_size 16k;
        limit_req zone=storefront_panels burst=6 nodelay;
        limit_req_status 429;
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }

    location / {
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }
}
