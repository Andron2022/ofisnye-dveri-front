upstream ofisnye_dveri_production {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name shop.example.com www.shop.example.com;
    return 301 https://shop.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name shop.example.com;

    ssl_certificate /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;

    client_max_body_size 128k;
    limit_conn storefront_per_ip 20;

    access_log /var/log/nginx/ofisnye-dveri-production.access.log;
    error_log /var/log/nginx/ofisnye-dveri-production.error.log warn;

    location = /api/checkout/order {
        client_max_body_size 64k;
        limit_req zone=storefront_checkout burst=4 nodelay;
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }

    location = /api/wall-panels/request {
        client_max_body_size 16k;
        limit_req zone=storefront_panels burst=6 nodelay;
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }

    location / {
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }
}
