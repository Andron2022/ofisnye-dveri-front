# Temporary HTTP-only configuration used before certificates exist.
# Replace both domains, enable the file, obtain two certificates, then disable it.
server {
    listen 80;
    listen [::]:80;
    server_name staging.ofisnyedveri.ru wp-staging.ofisnyedveri.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 404;
    }
}
