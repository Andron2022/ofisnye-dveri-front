# Temporary HTTP-only configuration used before production certificates exist.
# Keep production closed until DNS points here, obtain certificates, then disable this file.
server {
    listen 80;
    listen [::]:80;
    server_name ofisnyedveri.ru www.ofisnyedveri.ru wp.ofisnyedveri.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 404;
    }
}
