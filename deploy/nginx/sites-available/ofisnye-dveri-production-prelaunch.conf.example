upstream ofisnye_dveri_production {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ofisnye-dveri.ru www.ofisnye-dveri.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://ofisnye-dveri.ru$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.ofisnye-dveri.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ofisnye-dveri.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ofisnye-dveri.ru/privkey.pem;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    return 301 https://ofisnye-dveri.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ofisnye-dveri.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ofisnye-dveri.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ofisnye-dveri.ru/privkey.pem;

    # Prelaunch has two independent safety barriers:
    # 1) HTTP Basic Auth at Nginx;
    # 2) SITE_INDEXING_ENABLED=false inside Next.js.
    auth_basic "Production prelaunch";
    auth_basic_user_file /etc/nginx/.htpasswd-ofisnye-dveri-production-prelaunch;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    client_max_body_size 128k;
    limit_conn storefront_per_ip 20;

    access_log /var/log/nginx/ofisnye-dveri-production-prelaunch.access.log;
    error_log /var/log/nginx/ofisnye-dveri-production-prelaunch.error.log warn;

    location = /api/checkout/order {
        client_max_body_size 64k;
        limit_req zone=storefront_checkout burst=4 nodelay;
        limit_req_status 429;
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }

    location = /api/wall-panels/request {
        client_max_body_size 16k;
        limit_req zone=storefront_panels burst=6 nodelay;
        limit_req_status 429;
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }

    location / {
        proxy_pass http://ofisnye_dveri_production;
        include /etc/nginx/snippets/storefront-proxy.conf;
    }
}
