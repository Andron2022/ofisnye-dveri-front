# Non-secret facts fixed during the first staging deployment.
# Copy to /etc/ofisnye-dveri/staging-inventory.env and replace every example value.

ENVIRONMENT=staging
PROJECT_NAME=ofisnye-dveri

STOREFRONT_DOMAIN=staging-shop.example.com
WORDPRESS_DOMAIN=staging-wp.example.com
VDS_IPV4=203.0.113.10
VDS_IPV6=
DNS_PROVIDER=replace-me
DNS_TTL=300

EXPECTED_OS_ID=ubuntu
EXPECTED_OS_VERSION_ID=24.04
EXPECTED_NODE_MAJOR=24
NODE_BIN=/usr/local/bin/node
STOREFRONT_PORT=3001
PHP_FPM_SERVICE=php8.3-fpm
PHP_FPM_SOCKET=/run/php/php8.3-fpm.sock
MYSQL_SERVICE=mysql

APP_BASE=/srv/ofisnye-dveri
REPOSITORY_DIR=/srv/ofisnye-dveri/repository
APP_ROOT=/srv/ofisnye-dveri/staging
WORDPRESS_ROOT=/srv/wordpress/staging/public
LOCAL_BACKUP_ROOT=/var/backups/ofisnye-dveri/wordpress-staging

GIT_REPOSITORY_URL=git@github.com:replace-owner/replace-repository.git
GIT_DEPLOY_REF=origin/chore/staging-vds-foundation
DEPLOY_USER=deploy
RUNTIME_USER=storefront
RUNTIME_GROUP=storefront

STOREFRONT_NGINX_SITE=/etc/nginx/sites-available/ofisnye-dveri-staging
WORDPRESS_NGINX_SITE=/etc/nginx/sites-available/ofisnye-dveri-wp-staging
STOREFRONT_CERT_NAME=staging-shop.example.com
WORDPRESS_CERT_NAME=staging-wp.example.com

STOREFRONT_BASIC_AUTH_FILE=/etc/nginx/.htpasswd-ofisnye-dveri-staging
STOREFRONT_ENV_FILE=/etc/ofisnye-dveri/staging.env
WORDPRESS_BACKUP_ENV_FILE=/etc/ofisnye-dveri/wordpress-backup.env
RESTIC_ENV_FILE=/etc/ofisnye-dveri/restic-staging.env
