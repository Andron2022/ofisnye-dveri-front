# Non-secret production facts for the prelaunch contour.
# Copy to /etc/ofisnye-dveri/production-inventory.env and verify every value.

ENVIRONMENT=production
PROJECT_NAME=ofisnye-dveri

# Canonical public storefront + optional www redirect.
STOREFRONT_DOMAIN=ofisnye-dveri.ru
STOREFRONT_WWW_DOMAIN=www.ofisnye-dveri.ru
WORDPRESS_DOMAIN=wp.ofisnye-dveri.ru
VDS_IPV4=153.80.184.15
VDS_IPV6=
DNS_PROVIDER=replace-me
DNS_TTL=300

EXPECTED_OS_ID=ubuntu
EXPECTED_OS_VERSION_ID=24.04
EXPECTED_NODE_MAJOR=24
NODE_BIN=/usr/local/bin/node
STOREFRONT_PORT=3000
PHP_FPM_SERVICE=php8.3-fpm
PHP_FPM_SOCKET=/run/php/php8.3-fpm.sock
MYSQL_SERVICE=mysql

APP_BASE=/srv/ofisnye-dveri
REPOSITORY_DIR=/srv/ofisnye-dveri/repository
APP_ROOT=/srv/ofisnye-dveri/production
WORDPRESS_ROOT=/srv/wordpress/production/public
LOCAL_BACKUP_ROOT=/var/backups/ofisnye-dveri/wordpress-production

GIT_REPOSITORY_URL=git@github.com:replace-owner/replace-repository.git
GIT_DEPLOY_REF=origin/main
DEPLOY_USER=deploy
RUNTIME_USER=storefront
RUNTIME_GROUP=storefront

# During this step the prelaunch storefront config is active.
# The public production config is reserved for the later cutover step.
STOREFRONT_NGINX_SITE=/etc/nginx/sites-available/ofisnye-dveri-production-prelaunch
WORDPRESS_NGINX_SITE=/etc/nginx/sites-available/ofisnye-dveri-wp-production
STOREFRONT_CERT_NAME=ofisnye-dveri.ru
WORDPRESS_CERT_NAME=wp.ofisnye-dveri.ru

STOREFRONT_BASIC_AUTH_FILE=/etc/nginx/.htpasswd-ofisnye-dveri-production-prelaunch
WORDPRESS_ADMIN_BASIC_AUTH_FILE=/etc/nginx/.htpasswd-ofisnye-dveri-wp-production-admin
STOREFRONT_ENV_FILE=/etc/ofisnye-dveri/production.env
WORDPRESS_BACKUP_ENV_FILE=/etc/ofisnye-dveri/wordpress-production-backup.env
RESTIC_ENV_FILE=/etc/ofisnye-dveri/restic-production.env
