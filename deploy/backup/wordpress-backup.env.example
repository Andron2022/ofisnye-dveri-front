BACKUP_NAME=wordpress-staging
WP_ROOT=/srv/wordpress/staging/public
BACKUP_ROOT=/var/backups/ofisnye-dveri/wordpress-staging
RETENTION_DAYS=14

DB_NAME=wordpress_staging
MYSQL_BACKUP_DEFAULTS_FILE=/etc/ofisnye-dveri/mysql-backup.cnf
MYSQL_RESTORE_DEFAULTS_FILE=/etc/ofisnye-dveri/mysql-restore-admin.cnf
RESTORE_TEST_DB_NAME=wordpress_staging_restore_test

# Off-server copy. The backup fails visibly when enabled and restic upload fails.
OFFSITE_ENABLED=true
RESTIC_ENV_FILE=/etc/ofisnye-dveri/restic-staging.env
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6
