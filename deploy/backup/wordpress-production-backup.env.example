BACKUP_NAME=wordpress-production
WP_ROOT=/srv/wordpress/production/public
BACKUP_ROOT=/var/backups/ofisnye-dveri/wordpress-production
RETENTION_DAYS=14

DB_NAME=wordpress_production
MYSQL_BACKUP_DEFAULTS_FILE=/etc/ofisnye-dveri/mysql-production-backup.cnf
MYSQL_RESTORE_DEFAULTS_FILE=/etc/ofisnye-dveri/mysql-production-restore-admin.cnf
RESTORE_TEST_DB_NAME=wordpress_production_restore_test

# Off-server copy. Keep a repository separate from staging.
OFFSITE_ENABLED=true
RESTIC_ENV_FILE=/etc/ofisnye-dveri/restic-production.env
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6
