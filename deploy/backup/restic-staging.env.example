# Install as /etc/ofisnye-dveri/restic-staging.env, owner root:root, mode 600.
# Example for an S3-compatible bucket. Never commit real credentials.
RESTIC_REPOSITORY=s3:https://s3.example.com/ofisnye-dveri-staging
RESTIC_PASSWORD_FILE=/etc/ofisnye-dveri/restic-staging.password
RESTIC_CACHE_DIR=/var/cache/ofisnye-dveri/restic
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=replace_me
