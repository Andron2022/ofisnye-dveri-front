# Install as /etc/ofisnye-dveri/restic-production.env, owner root:root, mode 600.
# Production must use a separate restic path/repository namespace from staging.
RESTIC_REPOSITORY=s3:https://s3.example.com/ofisnye-dveri-production
RESTIC_PASSWORD_FILE=/etc/ofisnye-dveri/restic-production.password
RESTIC_CACHE_DIR=/var/cache/ofisnye-dveri/restic-production
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=replace_me
