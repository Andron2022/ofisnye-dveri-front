{
  "name": "kalles_nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file=.env.local .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "check:deploy-env": "node scripts/validate-deploy-env.mjs",
    "verify:deploy": "npm run check:deploy-env && npm run lint && npm run typecheck && npm run build",
    "preview": "npm run start"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "bootstrap": "^5.3.3",
    "flickity": "^3.0.0",
    "flickity-fade": "^2.0.0",
    "flickity-imagesloaded": "^2.0.0",
    "jarallax": "^2.2.0",
    "next": "15.5.21",
    "nouislider": "^15.8.1",
    "rc-slider": "^11.1.5",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.2",
    "react-countdown": "^2.3.5",
    "react-dom": "^19.0.0",
    "react-icons": "^5.2.1",
    "react-responsive": "^10.0.0",
    "sass": "^1.77.5",
    "sharp": "0.35.3",
    "swiper": "14.0.5"
  },
  "devDependencies": {
    "@types/flickity": "^2.2.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.19",
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=22.14.0 <25",
    "npm": ">=10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "unrs-resolver@1.11.1": true
  }
}
